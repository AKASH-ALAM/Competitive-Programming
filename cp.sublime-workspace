			"contents": "//using priority queue O(E log(V))\nvector <ll> dijkstra(ll V, vector<pair<ll, ll>> *adj, ll S) {\n\tpriority_queue <pair <ll, ll>, vector <pair<ll, ll>>, greater <pair<ll, ll>>> pq;\n\tvector <ll> dist(V, 1e18);\n\n\tpq.push({0, S});\n\tdist[S] = 0;\n\n\twhile (!pq.empty()) {\n\t\tauto [dis, u] = pq.top();\n\t\tpq.pop();\n\t\tif (dist[u] < dis) continue;\n\t\tfor (auto [v, w] : adj[u]) {\n\t\t\tif (dis + w < dist[v]) {\n\t\t\t\tdist[v] = dis + w;\n\t\t\t\tpq.push({dist[v], v});\n\t\t\t}\n\t\t}\n\t}\n\treturn dist;\n}\n\n//using set data structure\n// it's faster then priority queue\nvector <ll>  dijkstra(ll V, vector<pair<ll, ll>> *adj, ll S) {\n\tset <pair<ll, ll>> st;\n\tvector <ll> dist(V, 1e18);\n\n\tst.insert({0, S});\n\tdist[S] = 0;\n\n\twhile (!st.empty()) {\n\t\tauto [w, u] = *st.begin();\n\t\tst.erase(st.begin());\n\n\t\tfor (auto it : adj[u]) {\n\t\t\tauto [v, edgw] = it;\n\n\t\t\tif (w + edgw < dist[v]) {\n\t\t\t\tif (dist[v] != 1e18) st.erase({dist[v], v});\n\n\t\t\t\tdist[v] = w + edgw;\n\t\t\t\tst.insert({dist[v], v});\n\t\t\t}\n\t\t}\n\t}\n\treturn dist;\n}",
